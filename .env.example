# ---- Required ----
# Free PostgreSQL: create a project at https://neon.tech and paste its connection string here
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# Signs login cookies. Use a long random string (changing it logs everyone out).
SESSION_SECRET=paste-a-long-random-string-here

# Your site's address (used in email links)
APP_URL=http://localhost:3000

# ---- Optional ----
# Protects /api/cron/reminders (any long random string)
CRON_SECRET=change-me-to-something-random

# Email via Resend (https://resend.com). Without these, emails print in the terminal.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Glow Hair Studio <onboarding@resend.dev>

# WhatsApp via Twilio (https://www.twilio.com/whatsapp). Without these, messages print in the terminal.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
